# Copy to .env and paste your Firebase Web config (Project Settings → General → SDK setup → Config)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=thokupabhokta.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=thokupabhokta
VITE_FIREBASE_STORAGE_BUCKET=thokupabhokta.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abc...
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Comma-separated emails allowed to open the /#admin panel.
# These must also be listed in firestore.rules and storage.rules.
VITE_FIREBASE_ADMIN_EMAILS=admin@thokupabhokta.com,office@thokupabhokta.com

# Firestore collections to be created automatically on first write:
# - products (fields: title, category, specs, shortDesc, description, tags[], image, gallery[])
# - events (fields: title, date, sortDate, image, excerpt, full)
# - reports (fields: title, publishedDate, file, size, type)
# - enquiries (auto on form submit; staff read them in the /#admin inbox)
#   fields: productId, productTitle, category, name, phone, coop, qty, message, via, createdAt
#   contact form adds: email, type="contact"
# - siteInfo/main (single doc)

# Required once, to publish the secure rules (Firebase CLI: npm i -g firebase-tools; firebase login)
#   firebase deploy --only firestore:rules
#   firebase deploy --only storage
#
# Console steps for the admin panel:
#   1. Storage → Get started (enable Storage)
#   2. Authentication → Sign-in method → Email/Password → Enable
#   3. Authentication → Users → Add user (one per staff member)

